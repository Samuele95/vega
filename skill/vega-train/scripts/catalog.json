{
  "schema": "vega/training-catalog@1",
  "source": "vega-train/references/training-catalog.md §2-§4",
  "note": "Machine copy of the ladder rules, the diagnostics and the search spaces. plan_ladder.py, trainer.py and hpo.py read this file; tests/test_catalog_sync.py fails when it and the prose diverge. A rung's `vega:ladder/<rule>` source resolves against `ladder_rules`; a diagnostic's `train:diagnostic/<code>` against `diagnostics`. Every ladder rule but `selection` carries `expect_check`, its `expect` in the closed grammar of scripts/expectations.py (run-contract §3): the default a rung of that rule is judged by when it states none of its own; a diagnostic rung's `than` names R0 until the skill sets it to the run whose record fired it.",
  "ladder_rules": {
    "baseline": {
      "rung": "R0: the spec as engineered",
      "hypothesis": "none — it is what every other run is read against",
      "expect": "the spec's readings.per_family said what the first run must show; that is R0's expect",
      "expect_check": {
        "relation": "learns"
      },
      "order": 0,
      "unattended": true
    },
    "floor": {
      "rung": "the `linear` family on the same features (supervised), or `pca-floor` (reconstruction, anomaly); on a window `linear` reads the window through a `flatten` inserted before the head, at graph level through `graph_pool(mean)`, and at node level it is structure-blind (each node's own features); `pca-floor` reads the features through the bottleneck `dense(z, none)` inserted before the head, z the spec's own bottleneck (the narrowest top-level dense, or a reparameterize block's z) or else the geometry layer's dims_95; a spec whose family already is the floor gets none, nor does a node-level sample under neighbour sampling (the floor has no convolution to draw a fan-out for), nor a PCA floor with no z to read; its id is always R1",
      "hypothesis": "the non-linear structure the analysis or the posture claims is real",
      "expect": "the floor clearly below the baseline; if not, the network has not earned its parameters and the summary says so",
      "expect_check": {
        "relation": "worse",
        "metric": "valid.primary",
        "than": "R0",
        "margin": 0.05
      },
      "family": "architecture",
      "order": 1,
      "unattended": true,
      "floor_family": {
        "supervised": "linear",
        "reconstruction": "pca-floor",
        "anomaly": "pca-floor"
      },
      "inserts": {
        "row": [],
        "window": [
          {
            "type": "flatten",
            "params": {}
          }
        ],
        "graph/node": [],
        "graph/graph": [
          {
            "type": "graph_pool",
            "params": {
              "readout": "mean"
            }
          }
        ]
      },
      "pca_inserts": [
        {
          "type": "dense",
          "params": {
            "units": "z",
            "activation": "none"
          }
        }
      ],
      "pca_z": "the spec's bottleneck (the narrowest top-level dense's units, or a reparameterize block's z, whichever is narrower), else the geometry layer's space.dims_95 (families/pca-floor.defaults.z)",
      "catalog": "vega-forge catalog.json families/linear (floor_shapes), families/pca-floor (composition)"
    },
    "recurrent-floor": {
      "rung": "R1b, for the families the forge catalog's `rnn` row is the ablation floor of (`families/rnn.ablation_floor_for`: gru, lstm, bi-lstm, bi-gru, lstm-attention, gru-attention): the recurrent block swapped to `rnn` with the same `hidden` and `num_layers`, `return: last`, `bidirectional: false`, no `attention_pool` (every block the rnn composition does not hold removed), the head kept",
      "hypothesis": "the gated cell buys long-range memory: rnn must sit below the baseline",
      "expect": "valid primary(R1b) below valid primary(R0); if not, the gate buys nothing on windows of this length and the summary says so",
      "expect_check": {
        "relation": "worse",
        "metric": "valid.primary",
        "than": "R0"
      },
      "family": "architecture",
      "order": 2,
      "unattended": true,
      "catalog": "vega-forge catalog.json families/rnn (ablation_floor_for)"
    },
    "default-test": {
      "rung": "one rung per entry of the forge's defaults_to_test; a `data_contract/sample/<point>` entry (a sample fork point the forge defaulted) runs the forge catalog's alternative for that point",
      "hypothesis": "each default, tested by its removal or its first alternative",
      "expect": "the removal hurts on valid or widens the gap — the entry's own observation",
      "expect_check": {
        "any": [
          {
            "relation": "worse",
            "metric": "valid.primary",
            "than": "R0"
          },
          {
            "relation": "worse",
            "metric": "gap.loss",
            "than": "R0"
          }
        ]
      },
      "order": 3,
      "unattended": true,
      "unattended_max": 4,
      "unattended_order": [
        "dropout",
        "weight_decay",
        "schedule",
        "normalisation"
      ]
    },
    "spec-alternative": {
      "rung": "the first alternative of the family, the optimizer, the loss",
      "hypothesis": "the spec's own alternatives[0]",
      "expect": "stated by the alternative's `when`",
      "expect_check": {
        "relation": "not_better",
        "metric": "valid.primary",
        "than": "R0"
      },
      "order": 4,
      "unattended": false,
      "sections": [
        "family",
        "optimizer",
        "loss"
      ]
    },
    "capacity": {
      "rung": "width x2 and /2, or depth +-1",
      "hypothesis": "the catalog's sizing rule is near the right region",
      "expect": "the curve of valid metric against capacity peaks near the baseline",
      "expect_check": {
        "relation": "not_better",
        "metric": "valid.primary",
        "than": "R0"
      },
      "family": "architecture",
      "order": 5,
      "unattended": false
    },
    "hpo": {
      "rung": "one study on the family's §4 space, `lr` always included",
      "hypothesis": "the dimensions interact",
      "expect": "best trial >= baseline",
      "expect_check": {
        "relation": "not_worse",
        "metric": "valid.primary",
        "than": "R0"
      },
      "order": 6,
      "unattended": true,
      "trials_attended": 20,
      "trials_unattended": 12
    },
    "diagnostic": {
      "rung": "a rung a diagnostic proposed (§3): the first remedy in its row, unless the user picks another",
      "hypothesis": "the diagnostic's reading",
      "expect": "the remedy's predicted effect on the record that fired it",
      "expect_check": {
        "relation": "better",
        "metric": "valid.primary",
        "than": "R0"
      },
      "order": 7,
      "unattended": true,
      "unattended_max": 2
    },
    "selection": {
      "rung": "not a rung: the selection rule",
      "rule": "best valid primary in the direction of metrics.selection.mode; ties -> fewer params; ineligible: a run whose diagnostics include D1 (divergence) or D2 (not learning), a run stopped by budget before its first improvement (D9), a pruned trial",
      "alternative": "the user's pick with a reason, recorded as selection.override",
      "ineligible_codes": [
        "D1",
        "D2"
      ],
      "order": 8
    }
  },
  "unattended_ladder": [
    "baseline",
    "floor",
    "recurrent-floor",
    "default-test",
    "hpo"
  ],
  "rung_sources": [
    "netspec",
    "netspec:<path>",
    "vega:ladder/<rule>",
    "train:diagnostic/<code>",
    "train:hpo/<study>",
    "analysis:F<n>",
    "user:<turn|stance>"
  ],
  "diagnostics": {
    "D1": {
      "name": "divergence",
      "symptom": "a `nan` record, or train loss > 10x its epoch-1 value",
      "reading": "the learning rate is too high, an input is unscaled, or clipping is off",
      "remedies": [
        "lr / 10",
        "grad_clip on",
        "check the manifest's scale step"
      ],
      "needs": [
        "train.loss"
      ],
      "ineligible": true
    },
    "D2": {
      "name": "not learning",
      "symptom": "valid primary within 1 % of its epoch-1 value after 20 % of epochs, and update_ratio < 1e-5 on every block",
      "reading": "the learning rate is too low, activations are dead, or the head is wrong",
      "remedies": [
        "lr x 10",
        "activation gelu/leaky_relu",
        "the compiler's head check"
      ],
      "needs": [
        "valid.<primary>",
        "update_ratio"
      ],
      "ineligible": true
    },
    "D3": {
      "name": "overfitting after best epoch",
      "symptom": "after the best epoch, valid loss rises >= 5 % of its best value over 10 epochs while train loss falls",
      "reading": "capacity exceeds the rows; regularisation too weak",
      "remedies": [
        "dropout +0.2",
        "weight decay x10",
        "width /2",
        "earlier stop"
      ],
      "needs": [
        "valid.loss",
        "train.loss"
      ],
      "proposes_rung": true
    },
    "D4": {
      "name": "underfitting",
      "symptom": "train loss changed < 1 % over the last 20 % of epochs, train primary no better than the floor's valid primary (by >= 5 % of the floor's value, in the mode's direction), and the train/valid loss gap < 5 % of the valid loss",
      "reading": "capacity or epochs insufficient, or features carry little signal (cf. analysis:importance)",
      "remedies": [
        "width x2 / depth +1",
        "more epochs",
        "remove dropout"
      ],
      "needs": [
        "train.loss",
        "train.<primary>",
        "the floor run"
      ],
      "deferred_until": "the floor run exists",
      "proposes_rung": true
    },
    "D5": {
      "name": "thrashing",
      "symptom": "valid primary oscillates with std over the last 10 epochs > 5 % of its range so far, and update_ratio > 1e-2 on any block",
      "reading": "lr too high late, batch too small",
      "remedies": [
        "lr / 3",
        "batch x2",
        "schedule plateau when the spec has none"
      ],
      "needs": [
        "valid.<primary>",
        "update_ratio"
      ],
      "proposes_rung": true
    },
    "D6": {
      "name": "vanishing gradients",
      "symptom": "per-block gradient norm of the first block < 1e-3 x the head's for 5 epochs",
      "reading": "depth without residuals or normalisation, saturating activations",
      "remedies": [
        "residual, layernorm",
        "gelu"
      ],
      "needs": [
        "grad_norm.per_block"
      ],
      "proposes_rung": true
    },
    "D7": {
      "name": "exploding gradients",
      "symptom": "pre-clip global norm > 100 on >= 1 % of steps",
      "reading": "as D1 without divergence yet",
      "remedies": [
        "clipping tighter",
        "lr / 3"
      ],
      "needs": [
        "grad_stats.jsonl"
      ],
      "proposes_rung": true
    },
    "D8": {
      "name": "stale early stop",
      "symptom": "best epoch < 20 % of epochs, then no improvement",
      "reading": "the metric peaked early: lr too high after warmup, or the metric is noisy on a small valid part",
      "remedies": [
        "patience x2",
        "lr / 3",
        "min_delta lower"
      ],
      "needs": [
        "valid.<primary>"
      ],
      "proposes_rung": true
    },
    "D9": {
      "name": "budget cut",
      "symptom": "stopped_by: budget before early stopping (always fires on such a run)",
      "reading": "the run did not converge, or converged by accident of the budget; the campaign's budget, not the spec, ended it — never read as a result",
      "remedies": [
        "resume with --resume when budget is added"
      ],
      "needs": [
        "stopped_by"
      ],
      "ineligible_before_first_improvement": true
    },
    "D10": {
      "name": "train/valid disagreement",
      "symptom": "over the first 20 % of epochs (>= 5), train primary improves by >= 2 % of its range while valid primary worsens by >= 2 % of its range",
      "reading": "leakage in a feature the shaper kept, or a valid part from a different distribution (cf. analysis:modules/drift)",
      "remedies": [],
      "open_item_for": "/dataset-shaper",
      "needs": [
        "train.<primary>",
        "valid.<primary>"
      ],
      "proposes_rung": false
    },
    "D11": {
      "name": "dead embedding",
      "symptom": "an embedding's gradient norm is 0 for 3 epochs",
      "reading": "the nominal never varies in the batch order, or the cardinality is wrong",
      "remedies": [],
      "open_item_for": "/vega-forge",
      "needs": [
        "grad_norm.per_block"
      ],
      "proposes_rung": false
    },
    "D12": {
      "name": "calibration drift",
      "symptom": "over the last 10 epochs valid log-loss rises >= 5 % of its best value while valid ROC-AUC rises >= 0.005 (classification tasks only)",
      "reading": "scores are getting sharper without getting better; the class weight over-corrects",
      "remedies": [
        "pos_weight / 2",
        "label smoothing"
      ],
      "needs": [
        "valid.log_loss",
        "valid.roc_auc"
      ],
      "tasks": [
        "binary",
        "multiclass",
        "multilabel",
        "sequence-classification"
      ],
      "proposes_rung": true
    },
    "D13": {
      "name": "stopped before the schedule decayed",
      "symptom": "early stopping fired while the learning rate was still >= 80 % of its peak and the valid primary's slope over the last `patience` epochs is positive beyond its noise band (the sd of its epoch-to-epoch differences)",
      "reading": "the run was read as converged while it was still learning through noise; with the default patience every ablation is then compared at an under-trained baseline",
      "remedies": [
        "early_stopping.patience x 3 (run before the ablations are read; a ladder whose R0 fired D13 is re-based on it)"
      ],
      "needs": [
        "lr",
        "valid.<primary>",
        "run.stopped_by",
        "early_stopping.patience"
      ],
      "tasks": [
        "*"
      ],
      "proposes_rung": true
    }
  },
