{
  "schema": "vega/bundle-catalog@1",
  "source": "references/bundle-contract.md §1–§7",
  "note": "The machine copy of the bundle's shape: which files it must hold, which modules of the emitted package are its serving slice, which ports go out of scope and why, the round-trip tolerance formula, what each serving mode implies, and - from v2.3 - the reading vocabulary (vega/output@2), the field kinds the answer codec reads, the sample shapes, the monitor kinds, the serving template patterns and what a re-emit may change. pack.py and apply_bundle_layer.py read it; tests/test_catalog_sync.py fails when it and the prose diverge.",
  "required_files": [
    "MANIFEST.json",
    "netspec.json",
    "schema.json",
    "predict.py",
    "requirements.txt",
    "recipe.json",
    "fitted.json",
    "examples/rows.csv",
    "examples/expected.parquet",
    "tests/test_roundtrip.py",
    "README.md"
  ],
  "package_slice": {
    "keep": [
      "ports.py",
      "domain.py",
      "blueprint-map.json",
      "model/network.py",
      "model/store.py",
      "features/preprocess.py",
      "serving/predict.py",
      "serving/monitor.py"
    ],
    "drop_packages": [
      "ingestion",
      "training",
      "evaluation"
    ],
    "out_of_scope": {
      "DataSource": "the bundle takes rows from its caller; the chain's ingestion adapter reads the shaped parts, which a served model never sees",
      "Trainer": "the bundle serves a trained network and never fits one",
      "Evaluator": "the evaluation happened once, under seal, upstream; a bundle that could evaluate could re-expose the test part"
    }
  },
  "include": {
    "default": "serving",
    "modes": {
      "serving": {
        "keeps": "the serving slice",
        "entrypoints": [
          "predict.py"
        ],
        "out_of_scope": true,
        "conformance_bundle_mode": true
      },
      "full": {
        "keeps": "the whole emitted package",
        "entrypoints": [
          "predict.py",
          "train.py",
          "evaluate.py"
        ],
        "out_of_scope": false,
        "conformance_bundle_mode": false,
        "seal": "load_part still refuses the test part and load_sealed_part still wants test_seal.json and its token; the door travels with its lock"
      }
    }
  },
  "records": {
    "dir": "records",
    "layers": [
      "geometry",
      "analysis",
      "shape",
      "architecture",
      "training",
      "evaluation"
    ],
    "note": "the six layers' data copied out of the model page, verbatim; the card and the notebook read them and nothing in the bundle imports them"
  },
  "roundtrip": {
    "rule": "1e-6 * max(1, max|score|)",
    "value": 1e-06,
    "precision": "fp32",
    "reduced_precision_note": "a checkpoint below fp32 uses the backend's declared inference tolerance instead; the manifest records which rule was applied"
  },
  "serving_modes": {
    "online": {
      "serve": true,
      "framework": "fastapi",
      "entry": "serve/app.py",
      "endpoint": "POST /predict"
    },
    "stream": {
      "serve": true,
      "framework": "consumer",
      "entry": "serve/consumer.py",
      "endpoint": null
    },
    "batch": {
      "serve": false,
      "framework": null,
      "entry": null,
      "endpoint": "predict.py --input (the CLI is the batch interface)"
    }
  },
  "export_formats": [
    "onnx",
    "torchscript"
  ],
  "export_parity_atol": 1e-05,
  "examples": {
    "default_rows": 50,
    "kinds": [
      "test",
      "synthetic"
    ],
    "schema": "vega/examples@2",
    "json_schema": "references/schemas/examples-2.schema.json",
    "files": {
      "demo": {
        "path": "examples/demo.json",
        "schema": "vega/demo@2",
        "json_schema_def": "#/$defs/demo"
      },
      "presets": {
        "path": "examples/presets.json",
        "schema": "vega/presets@2",
        "json_schema_def": "#/$defs/presets_file"
      },
      "request": {
        "path": "examples/request.json",
        "schema": null,
        "json_schema_def": null
      }
    },
    "stratum_kinds": [
      "class",
      "label",
      "bin",
      "none",
      "typical",
      "flagged",
      "all"
    ],
    "expected_kinds": [
      "class",
      "labels",
      "value",
      "alarm"
    ],
    "preset_groups": [
      "typical",
      "edge"
    ],
    "preset_kinds": {
      "typical_correct": {
        "group": "typical",
        "facts": [
          "right",
          "of"
        ]
      },
      "typical_none_correct": {
        "group": "typical",
        "facts": [
          "right",
          "of"
        ]
      },
      "typical_bin": {
        "group": "typical",
        "facts": [
          "bin"
        ]
      },
      "typical_score": {
        "group": "typical",
        "facts": [
          "of"
        ]
      },
      "typical_sequence": {
        "group": "typical",
        "facts": [
          "of"
        ]
      },
      "edge_range": {
        "group": "edge",
        "facts": [
          "column",
          "factor"
        ]
      },
      "edge_infinity": {
        "group": "edge",
        "facts": [
          "columns"
        ]
      },
      "edge_unseen": {
        "group": "edge",
        "facts": [
          "column",
          "value"
        ]
      }
    },
    "strings": "the page renders preset.<kind>.name and preset.<kind>.text from facts; no English ships in the payload"
  },
  "output_readings": {
    "schema": "vega/output@2",
    "source": "references/bundle-contract.md §2.1 (Readings); build plan R-A8, R-A9, R-C1, R-C3, R-C4, R-C6",
    "record_keys": [
      "schema",
      "kind",
      "reading",
      "base",
      "link",
      "decision",
      "head_out",
      "classes",
      "positive",
      "threshold",
      "threshold_source",
      "threshold_scale",
      "threshold_per_label",
      "quantiles",
      "horizons",
      "fields",
      "field_kinds",
      "compared",
      "decided",
      "score_field",
      "truth"
    ],
    "links": [
      "softmax",
      "sigmoid",
      "sigmoid_each",
      "identity",
      "cumulative",
      "reconstruction",
      "distance",
      "horizon"
    ],
    "decisions": [
      "threshold",
      "argmax",
      "per-label-threshold",
      "cumulative",
      "none"
    ],
    "decided_sources": [
      "argmax",
      "cumulative",
      "threshold"
    ],
    "truth_types": [
      "class",
      "number",
      "labels"
    ],
    "conditions": {
      "loss": "spec.loss.name is one of the listed names",
      "head_out_gt": "head_out (params.out of the spec's last `head` block) is greater than the number",
      "head_out_eq": "head_out equals the number",
      "has": "the dotted spec path is present and not null"
    },
    "resolve_rule": "rules are tried in order and the first whose kind matches and whose `when` holds wins; `@base` resolves the base kind through R1-R6 with the same spec (so a regression base with a quantile loss reads as quantile); the base is task.base_kind, else the v22_fallback rules for a v2.2 spec without it; a kind no rule matches is refused: ERROR: task.kind <k> has no serving reading (exit 2)",
    "resolve": [
      {
        "rule": "R1",
        "kind": "binary",
        "reading": "binary"
      },
      {
        "rule": "R2",
        "kind": "multiclass",
        "reading": "multiclass"
      },
      {
        "rule": "R3",
        "kind": "multilabel",
        "reading": "multilabel"
      },
      {
        "rule": "R4",
        "kind": "ordinal",
        "reading": "ordinal"
      },
      {
        "rule": "R5",
        "kind": "regression",
        "when": {
          "loss": [
            "quantile"
          ],
          "head_out_gt": 1
        },
        "reading": "quantile"
      },
      {
        "rule": "R6",
        "kind": "regression",
        "reading": "regression"
      },
      {
        "rule": "R7",
        "kind": "unsupervised",
        "reading": "reconstruction"
      },
      {
        "rule": "R8",
        "kind": "anomaly",
        "when": {
          "loss": [
            "svdd"
          ]
        },
        "reading": "anomaly-svdd"
      },
      {
        "rule": "R9",
        "kind": "anomaly",
        "reading": "anomaly-reconstruction"
      },
      {
        "rule": "R10",
        "kind": "sequence-classification",
        "reading": "@base",
        "base": {
          "from": "task.base_kind",
          "allowed": [
            "binary",
            "multiclass",
            "multilabel"
          ],
          "v22_fallback": [
            {
              "when": {
                "head_out_eq": 1
              },
              "base": "binary"
            },
            {
              "when": {
                "has": "task.label_format"
              },
              "base": "multilabel"
            },
            {
              "when": {
                "loss": [
                  "bce_with_logits"
                ]
              },
              "base": "multilabel"
            },
            {
              "base": "multiclass"
            }
          ]
        }
      },
      {
        "rule": "R11",
        "kind": "sequence-regression",
        "reading": "@base",
        "base": {
          "from": "task.base_kind",
          "allowed": [
            "regression",
            "ordinal"
          ],
          "v22_fallback": [
            {
              "when": {
                "loss": [
                  "cumulative_link"
                ]
              },
              "base": "ordinal"
            },
            {
              "base": "regression"
            }
          ]
        }
      },
      {
        "rule": "R12",
        "kind": "forecast",
        "reading": "forecast",
        "base": {
          "fixed": "regression"
        }
      }
    ],
    "placeholders": {
      "<class>": "each name of `classes`, in spec order (binary: [negative, positive])",
      "<positive>": "the positive class: str(task.positive), else the last class, else \"1\"",
      "<label>": "each label name of a multilabel task, in spec order",
      "<cum>": "each cumulative threshold class c_j of an ordinal head, j < K-1",
      "<q>": "each quantile of loss.params.quantiles, as format(q*100, \"g\") with \".\" replaced by \"p\" (0.1 -> 10, 0.025 -> 2p5)",
      "<median>": "the <q> token of the quantile nearest 0.5",
      "<h>": "each horizon step 1..H",
      "<feature>": "each input feature of the FeatureContract, numeric then nominal",
      "<j>": "each embedding coordinate 0..head_out-1",
      "<k>": "the stored score column index, horizon-major for (H, Q) heads; `score_<k>` is the one column `score` when head_out is 1"
    },
    "shape_fields": {
