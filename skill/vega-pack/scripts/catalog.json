          "label": "task.classes is present (a labelled anomaly task)"
        },
        "compared": [
          [
            "emb_<j>",
            "score_<k>"
          ],
          [
            "score",
            "row_score"
          ]
        ],
        "decided": [
          [
            "prediction",
            "prediction"
          ]
        ],
        "score_field": [
          "score"
        ],
        "truth": "class",
        "truth_optional": true,
        "sums_to_one": false,
        "describe": {
          "score": "float >= 0, the squared distance ||f(x) - c||^2 to the centre the model carries; higher is more anomalous",
          "prediction": "0|1: score >= threshold (score scale), the threshold /vega-eval chose on the valid part",
          "label": "the decided class by name (the positive class when prediction is 1), only for a labelled anomaly task",
          "emb_<j>": "float, coordinate j of the embedding f(x)"
        }
      }
    }
  },
