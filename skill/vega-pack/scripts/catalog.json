  "sample_shapes": {
    "row": {
      "record": [
        "shape"
      ],
      "examples": "the first n test rows; expected rows 0..n-1",
      "request": {
        "rows": "[the first example row]"
      },
      "history": "only for a recipe with a lag step: the raw rows preceding the query"
    },
    "window": {
      "record": [
        "shape",
        "length",
        "stride",
        "horizon",
        "series_by",
        "order_by",
        "context",
        "autoregressive",
        "lag_depth",
        "history_rows",
        "rule"
      ],
      "forecast_only": [
        "horizon",
        "autoregressive"
      ],
      "contexts": [
        "previous-part",
        "none"
      ],
      "lag_depth": "max(max(step.params.lags)) over the recipe steps with op lag, else 0",
      "history_rows": "(length - 1) + lag_depth",
      "rule": "each row is a window end; answered when length-1 preceding rows of its series exist in history + rows",
      "examples": "context rows first, then n scored rows; expected rows carry __row__",
      "request": {
        "rows": "[the anchor row]",
        "history": "[its history_rows predecessors]"
      }
    },
    "graph": {
      "record": [
        "shape",
        "level",
        "protocol",
        "method",
        "directed",
        "self_loops",
        "graph_id",
        "reference",
        "rule"
      ],
      "levels": [
        "node",
        "graph"
      ],
      "protocols_served": [
        "inductive"
      ],
      "protocols_refused": {
        "transductive": "ERROR: transductive graph protocol: the served answers would depend on the fixed deployment graph; /vega-pack v2.3 serves inductive graphs only (exit 2)"
      },
      "reference_schema": "vega/graph-reference@1",
      "reference_parts": [
        "train",
        "valid"
      ],
      "files": [
        "graph/reference-nodes.parquet",
        "graph/reference-edges.parquet",
        "graph/graph.json"
      ],
      "warn_reference_nodes_above": 1000000,
      "rule": "messages flow reference -> query only; an answer does not depend on the other rows of the request",
      "examples": "node level: the first n test rows; graph level: whole test graphs",
      "request": {
        "rows": "node level: [the first example row]; graph level: the rows of one graph"
      }
    }
  },
