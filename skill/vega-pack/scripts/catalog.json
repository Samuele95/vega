  "serving_template_rule": {
    "root": "templates/serving/ of the backend (pytorch: vega-forge/scripts/backends/pytorch/templates/serving/)",
    "match": "a pattern matches a template path relative to the root when both have the same number of /-separated segments and each segment matches under fnmatch.fnmatchcase: * never crosses a /, and it matches a leading dot",
    "destinations": {
      "package": "<package>/<serving module>/",
      "serve": "serve/",
      "bundle": "",
      "tests": "tests/"
    },
    "render": "the pattern's first segment names the destination and is replaced by it: package/inspection/codec.py renders to <package>/<serving module>/inspection/codec.py"
  },
  "reemit": {
    "may_change": {
      "templates": [
        "package/*.py",
        "package/inspection/*.py",
        "serve/*.py",
        "serve/static/index.html",
        "bundle/*",
        "tests/*.py"
      ],
      "manifest": [
        "created_at",
        "reemits",
        "blueprint.conformance",
        "serve",
        "roles",
        "roundtrip",
        "exports",
        "files (the outputs of the templates only)"
      ]
    },
    "never": [
      "weights.*",
      "netspec.json",
      "recipe.json",
      "fitted.json",
      "schema.json",
      "monitor-reference.json",
      "examples/*",
      "graph/*",
      "records/*",
      "<package>/ files outside the serving templates' outputs (wherever the map puts them)"
    ],
    "refusal": "ERROR: re-emit would change <files>; what the evaluation pinned is not the serving templates' to change — re-pack deliberately (exit 3, bundle untouched)"
  },
