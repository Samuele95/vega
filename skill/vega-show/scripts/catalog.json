{
  "schema": "vega/show-catalog@1",
  "source": "references/show-contract.md §1–§11",
  "note": "Machine copy of show-contract.md. The vega-show scripts read their closed sets, bounds and tables from this file and never restate them in code; tests/test_catalog_sync.py fails when this file and the prose diverge, when either disagrees with the vega-forge catalog (tasks, families, blocks, sample shapes, decision families, metric_direction), the vega-eval catalog (baselines, metric sets) or the backend's METRICS, and when a schema under references/schemas/ does not validate or names a closed set differently. The metric-direction table is the vega-forge catalog's (metric_direction); this file keeps no copy.",

  "stage": { "name": "show", "skill": "vega-show", "layer": "showcase", "stem_tag": ".show",
             "run_dir": "<bundle>/showcase", "brief": "<bundle>/showcase/docs/show-brief.md", "post_report": true,
             "after": ["pack", "document"], "reads": ["<stem>.pack.html", "<bundle>/", "docs/"],
             "required_layers": ["geometry", "shape", "architecture", "training", "evaluation", "bundle"],
             "optional_layers": ["analysis"] },

  "exit_codes": { "ok": 0, "refused": 2, "stale": 3, "platform_writer_missing": 3 },
  "check_status": { "pass": 0, "broken": 2, "stale": 3 },
  "markers": ["OK:", "WARN:", "ERROR:", "FORK:"],

  "schemas": {
    "vega/showcase@1":     { "file": "references/schemas/showcase-1.schema.json",     "written_by": "build_showcase.py (H06)",            "read_by": ["serve/routes_showcase.py (I07)", "showcase_check.py", "apply_show_layer.py", "/vega"] },
    "vega/story@2":        { "file": "references/schemas/story-2.schema.json",        "written_by": "resolve_story.py (H05)",             "read_by": ["assets/page (W08–W13)", "page_config.py (W06)", "apply_show_layer.py"] },
    "vega/story-plan@2":   { "file": "references/schemas/story-plan-2.schema.json",   "written_by": "draft_plan.py (H04) + the model",    "read_by": ["plan_rules.py", "resolve_story.py"] },
    "vega/show-facts@1":   { "file": "references/schemas/show-facts-1.schema.json",   "written_by": "extract_facts.py (H03)",             "read_by": ["draft_plan.py", "plan_rules.py", "resolve_story.py", "the brief"] },
    "vega/label-roles@1":  { "file": "references/schemas/label-roles-1.schema.json",  "written_by": "document-project (H02 patch), lanekit report_stub (T03)", "read_by": ["role_map.py (H01)", "facts_report.py (H03)"] },
    "vega/page@1":         { "file": "references/schemas/page-1.schema.json",         "written_by": "page_config.build_page_config (W06) inside build_showcase.py", "read_by": ["assets/page", "smoke_page.py"] },
    "vega/attribution@2":  { "file": "references/schemas/attribution-2.schema.json",  "written_by": "attribution_build.py (H06)",         "read_by": ["assets/page js/net/weights.js (W05)"] },
    "vega/page-probe@1":   { "file": "references/schemas/page-probe-1.schema.json",   "written_by": "assets/page js/core/probe.js (W15)", "read_by": ["smoke_page.py", "serve_probe.py", "vega/scripts/tests/page_smoke.py"] },
    "vega/page-template@1":{ "file": "references/schemas/page-template-1.schema.json","written_by": "page_template.write_manifest (W07, first generated by W15)", "read_by": ["page_template.verify_template_copy", "build_showcase.py", "showcase_check.py"] }
  },
  "blocks": {
    "vega/lexicon@1":     "story-2 $defs/lexicon",
    "vega/class-roles@1": "story-2 $defs/class_roles",
    "input_groups@2":     "story-2 $defs/input_groups",
    "focus@1":            "story-2 $defs/focus",
    "breakdown@1":        "story-2 $defs/breakdown",
    "code_notes@1":       "story-2 $defs/code_note"
  },

  "fact_sources": ["MANIFEST.json", "netspec.json", "schema.json", "records/geometry.json", "records/analysis.json",
                   "records/shape.json", "records/architecture.json", "records/training.json", "records/evaluation.json", "report:"],
  "fact_key_pattern": "^[a-z][a-z0-9_]{0,63}$",
  "ref_pattern": "^((MANIFEST|netspec|schema)\\.json|records/(geometry|analysis|shape|architecture|training|evaluation)\\.json)#[^\\s#]+$|^report:[a-z][a-z0-9.-]*\\.(number|page|title)$",
  "fact_kinds": ["count", "size", "metric", "ci_metric", "diff", "param", "epoch", "list", "labels", "count_of",
                 "report_number", "report_page", "text"],
  "formats": ["count", "metric", "ci", "param", "epoch", "verbatim", "list"],
  "derivations": ["count_of"],
  "fact_groups": ["sizes", "recipe", "split", "sample", "inputs", "class_balance", "network", "decisions", "runs",
                  "selection", "hpo", "models", "metrics", "diffs", "breakdown", "verdict", "limits", "identity",
                  "report", "briefs", "prose_sources"],
  "reserved_values": {
    "primary":  { "fact": "eval_network_<primary>", "ref": "records/evaluation.json#metrics.models.network.<primary>", "shape": "{value, ci, n}",
                  "metric": "the vega-forge tasks[].primary, or primary_alt.metric when its condition holds (anomaly with no label: anomaly_score_mean, R-C7)",
                  "direction": "metric_direction in the vega-forge catalog, max or min" },
    "ci_level": { "fact": "eval_ci_level", "ref": "records/evaluation.json#metrics.ci_level", "shape": "number in (0, 1)",
                  "absent": "WARN: the evaluation records no ci_level — the page prints the interval without a level" }
  },

  "limit_kinds": {
    "split":               { "mandatory": "always" },
    "exposures":           { "mandatory": "always" },
    "one_seed":            { "mandatory": "always" },
    "robustness_not_run":  { "mandatory": "when_present" },
    "verdict_not_earned":  { "mandatory": "when_present" },
    "verdict_beaten":      { "mandatory": "when_present" },
    "verdict_not_assessable": { "mandatory": "when_present" },
    "ship_stance":         { "mandatory": "when_present" },
    "roundtrip_boundary":  { "mandatory": "when_present" },
    "examples_synthetic":  { "mandatory": "never" },
    "calibration":         { "mandatory": "never" },
    "slices_empty":        { "mandatory": "never" },
    "small_support": {"mandatory": "when_present", "below": 30, "rule": "a class of the task with fewer sealed test rows than `below` (records/evaluation.json#metrics.class_support): its per-class reading is an anecdote"},
    "drift_suspected":     { "mandatory": "never" },
    "serving_forced":      { "mandatory": "never" },
    "warn":                { "mandatory": "never" }
  },

  "placeholder": {
    "pattern": "\\{([a-z][a-z0-9_]*)(?:\\.([a-z][a-z0-9_]*))?(?::(int|num|pct|signed|count))?\\}",
    "suffixes": ["int", "num", "pct", "signed", "count"],
    "bare": "a fact key (story text) or a runtime parameter (page strings)",
    "dotted": "a lexicon path {<key>.<path>} or a strings-derived noun ({target.one})"
  },
  "digit_rule": {
    "token_pattern": "[^\\W_]+(?:[-'][^\\W_]+)*",
    "refuse": ["a token with a decimal digit and no letter", "a token with a decimal digit that is not in facts.names (case-insensitive)",
               "any other Unicode Nd character outside a token"],
    "accept": ["a token with a digit and a letter that facts.names carries"],
    "applies_to": ["every authored string of story-plan@2", "the strings table values", "the explain catalog prose", "the layer's readings"]
  },
  "name_tokens": ["F1", "L1", "L2", "ReLU6", "top5", "IPv4", "IPv6", "P2P", "3D", "2D", "1D"],
  "number_words": ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen",
                   "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty", "thirty", "forty", "fifty",
                   "sixty", "seventy", "eighty", "ninety", "hundred", "thousand", "million", "billion", "half", "twice", "double",
                   "triple", "percent", "dozen"],

  "motifs": {
    "set": ["grid", "points", "traces", "lanes", "links", "contours"],
    "by_modality": {
      "row":         { "base": "points",   "admissible": ["points", "lanes", "grid"] },
      "spatial-row": { "base": "contours", "admissible": ["contours", "points", "lanes", "grid"] },
      "window":      { "base": "traces",   "admissible": ["traces", "lanes", "grid"] },
      "graph":       { "base": "links",    "admissible": ["links", "grid"] }
    },
    "modality_rule": "spatial-row when the sample shape is row and records/analysis.json#context.spatial is non-null; otherwise the sample shape",
    "fork": "S3",
    "source_pattern": "^(vega:default|user:.+|show:\\d{4}-\\d{2}-\\d{2})$",
    "alert_share": 0.07,
    "element": "#field",
    "attribute": "data-motif"
  },

  "roles": {
    "set": ["neutral", "alert", "plain"],
    "default": "plain",
    "basis": {
      "structural:majority": { "grants": ["neutral"], "rule": "the train-majority class, when its train share is at least neutral_majority_share" },
      "structural:negative": { "grants": ["neutral"], "rule": "the negative class of a binary task (schema.label.decode value 0, or the class data_contract marks negative)" },
      "task:anomaly":        { "grants": ["neutral", "alert"], "rule": "the normal side is neutral and the anomalous side alert, by task; the anomalous side is never downgraded" },
      "user:<turn>":         { "grants": ["neutral", "alert", "plain"], "rule": "the user said so in this conversation" },
      "show:<stance date>":  { "grants": ["neutral", "alert", "plain"], "rule": "a show: roles line of that date in .claude/domain-forge-memory.md § Network stances" },
      "registry:<lane>":     { "grants": ["neutral", "alert", "plain"], "rule": "the verification harness's lane registry declares it: VEGA_LANE_REGISTRY, which the matrix sets and a production run never does, names the registry, and it holds the lane and gives the class that role; without it V6 refuses the basis; never a user's turn" },
      "vega:default":        { "grants": ["neutral", "plain"], "rule": "a proposal applied without an answer; never alert" }
    },
    "basis_pattern": "^(structural:(majority|negative)|task:anomaly|user:.+|show:\\d{4}-\\d{2}-\\d{2}|registry:[A-Za-z0-9_-]+|vega:default)$",
    "alert_requires": ["user:", "show:", "registry:", "task:anomaly"],
    "evidence_only": ["domain:", "spec:"],
    "neutral_rules": { "binary": "structural:negative", "multiclass": "structural:majority", "anomaly": "task:anomaly",
                       "sequence-classification": { "binary": "structural:negative", "multiclass": "structural:majority" } },
    "neutral_majority_share": 0.5,
    "covers": { "classes": "task.classes", "binary": "task.classes", "labels": "task.classes (the label names)", "ordinal": "task.classes",
                "anomaly": "the two sides, named by the task's class names when a label exists, else normal and anomalous",
                "value": null, "reconstruction": null, "horizon": null },
    "neutral_at_most_one": ["classes", "binary", "anomaly"],
    "anomaly_sides": ["normal", "anomalous"],
    "fork": "S2"
  },

  "lexicon": {
    "schema": "vega/lexicon@1",
    "keys": ["row", "feature", "source", "step", "window", "node", "edge", "graph", "target"],
    "optional": ["target"],
    "entry": ["one", "many", "article"],
    "value_pattern": "^[a-z][a-z' -]{0,30}$",
    "articles": { "default": ["a", "an"], "source": ["a", "an", "the"] },
    "paths": ["one", "many", "a", "the"],
    "required": {
      "row":         ["row", "feature", "source"],
      "window":      ["row", "feature", "source", "step", "window"],
      "graph:node":  ["row", "feature", "source", "node", "edge"],
      "graph:graph": ["row", "feature", "source", "node", "edge", "graph"]
    },
    "defaults": {
      "row":     { "one": "row", "many": "rows", "article": "a" },
      "feature": { "one": "input", "many": "inputs", "article": "an" },
      "source":  { "one": "source data", "many": "source data", "article": "the" },
      "step":    { "one": "step", "many": "steps", "article": "a" },
      "window":  { "one": "window", "many": "windows", "article": "a" },
      "node":    { "one": "node", "many": "nodes", "article": "a" },
      "edge":    { "one": "edge", "many": "edges", "article": "an" },
      "graph":   { "one": "graph", "many": "graphs", "article": "a" }
    },
    "row_from": "MANIFEST.json#serve.identity.noun and .nouns when present, the article by the first letter (a before a consonant, an before a vowel)",
    "target_default": "the strings key target.one / target.many in the lane's view-key variant",
    "identity": "title and description come from MANIFEST.json#serve.identity into page.json.identity, never from the lexicon"
  },

  "view_keys": {
    "binary": "binary", "multiclass": "classes", "multilabel": "labels", "regression": "value", "ordinal": "ordinal",
    "unsupervised": "reconstruction", "anomaly": "anomaly",
    "sequence-classification": { "binary": "binary", "multiclass": "classes", "multilabel": "labels" },
    "sequence-regression": { "regression": "value", "ordinal": "ordinal" },
    "forecast": "horizon"
  },

  "polarity": {
    "values": ["neutral-alert", "plain", "diverging", "normal-anomalous"],
    "by_task": {
      "binary":                  ["neutral-alert", "plain"],
      "multiclass":              ["neutral-alert", "plain"],
      "multilabel":              ["neutral-alert", "plain"],
      "regression":              ["diverging", "diverging"],
      "ordinal":                 ["diverging", "diverging"],
      "unsupervised":            ["plain", "plain"],
      "anomaly":                 ["normal-anomalous", "plain"],
      "sequence-classification": ["neutral-alert", "plain"],
      "sequence-regression":     ["diverging", "diverging"],
      "forecast":                ["diverging", "diverging"]
    },
    "rule": "the first value when any class role is alert, the second otherwise"
  },

  "sections": { "ids": ["context", "network", "experiments", "results", "many"],
                "required": ["context", "network", "experiments", "results"] },

  "context_steps": {
    "ids": ["problem", "data", "windows", "graph", "cleaning", "split"],
    "by_shape": {
      "row":    ["problem", "data", "cleaning", "split"],
      "window": ["problem", "data", "windows", "cleaning", "split"],
      "graph":  ["problem", "data", "graph", "cleaning", "split"]
    },
    "title_key": "context.step.<id>"
  },

  "result_models": {
    "names": ["network", "trivial", "linear", "tree", "naive", "seasonal-naive", "graph-linear", "lens", "campaign"],
    "from_baseline": { "trivial": "trivial", "linear": "linear", "tree": "tree", "naive": "naive", "seasonal-naive": "seasonal-naive",
                       "graph-linear": "graph-linear", "lens": "lens", "campaign-baseline": "campaign" },
    "label_key": "model.<name>"
  },

  "results_facts": {
    "binary": ["roc_auc", "pr_auc", "balanced_accuracy", "ece"],
    "multiclass": ["balanced_accuracy", "accuracy", "ece", "mcc"],
    "multilabel": ["f1_macro", "hamming", "subset_accuracy"],
    "regression": ["mae", "r2", "median_ae"],
    "ordinal": ["accuracy", "qwk"],
    "unsupervised": ["r2"],
    "anomaly": ["roc_auc", "precision_at_k", "recall_at_k"],
    "sequence-classification": ["roc_auc", "pr_auc", "accuracy"],
    "sequence-regression": ["mae", "r2"],
    "forecast": ["smape", "rmse", "mae"]
  },

  "results_emit": {
    "ref": "records/evaluation.json#metrics.models.network.<metric>",
    "when": "a results fact is emitted only when its ref exists; the anomaly facts on an unlabelled lane are absent, so its results view shows only the primary",
    "absent": "no fact, no proposal, no note and no WARN:"
  },

  "breakdown": {
    "kinds": ["per_class", "per_label", "per_bin", "per_horizon", "per_feature", "at_k"],
    "by_task": {
      "binary": null,
      "multiclass":   { "kind": "per_class",   "metric": "f1_per_class",      "direction_of": "f1" },
      "multilabel":   { "kind": "per_label",   "metric": "pr_auc",            "direction_of": "pr_auc" },
      "regression": null,
      "ordinal": null,
      "unsupervised": { "kind": "per_feature", "metric": "per_feature_error", "direction_of": "reconstruction_error" },
      "anomaly": null,
      "sequence-classification": "base",
      "sequence-regression": "base",
      "forecast":     { "kind": "per_horizon", "metric": "per_horizon_error", "direction_of": "mae" }
    },
    "weak": "the per-unit value is worse than the trivial baseline's per-unit value in the metric's direction, or its interval's far end is worse than the evaluation's recorded bar; computed by resolve_story.py, never by the page"
  },

  "decision_families": { "architecture": ["family", "blocks"], "objective": ["loss", "metrics"],
                         "optimization": ["optimizer", "schedule", "training", "init"], "regularization": ["regularization", "early_stopping"] },
  "focus": {
    "kinds": ["block", "family", "feature", "all"],
    "families": ["architecture", "objective", "optimization", "regularization"],
    "by_decision": { "family": "architecture", "loss": "objective", "metrics": "objective", "optimizer": "optimization",
                     "schedule": "optimization", "training": "optimization", "init": "optimization",
                     "regularization": "regularization", "early_stopping": "regularization" },
    "block": "a decision that is a block id becomes {kind: block, ref: <id>}",
    "feature": "a decision whose features_tested is non-empty and whose authored text names a tested feature becomes {kind: feature, ref: <input name>}"
  },
  "choices": { "min": 3, "max": 8 },
  "choice_skip_types": ["concat", "flatten", "reshape", "positional"],
  "input_groups": { "min": 3, "max": 9, "min_applies_from_inputs": 9, "corr_threshold": 0.8, "id_pattern": "^[a-z][a-z0-9_]{0,31}$" },
  "delta_label": { "family": "family {from} → {to}", "blocks": "{block} {param} {from} → {to}", "loss": "loss {param} {from} → {to}",
                   "optimizer": "optimizer {param} {from} → {to}", "schedule": "schedule {from} → {to}",
                   "regularization": "{kind} {from} → {to}", "features": "without {features}" },
  "authored_lengths": { "headline": 160, "lead": 280, "caption": 200, "context_step": 700, "fact_label": 40,
                        "choice_title": 60, "choice_text": 600, "run_label": 60, "note": 160, "code_note": 160,
                        "limit_title": 60, "limit_text": 400, "group_label": 40, "group_text": 160,
                        "monitor_note": 240, "abstract_min": 40 },
  "locales": ["en"],
  "build_locales": ["en", "qps-ploc"],

  "report_roles": {
    "intro.lane":         { "kind": "figure",   "stage": "forge-data", "keywords": ["lane", "chain", "pipeline"] },
    "chapter.forge-data": { "kind": "section",  "stage": "forge-data", "keywords": ["data", "geometry"] },
    "chapter.lens":       { "kind": "section",  "stage": "lens",       "keywords": ["analysis", "findings"] },
    "chapter.shape":      { "kind": "section",  "stage": "shape",      "keywords": ["shaping", "preparing", "recipe"] },
    "chapter.blueprint":  { "kind": "section",  "stage": "blueprint",  "keywords": ["architecture", "blueprint", "system"] },
    "chapter.net":        { "kind": "section",  "stage": "net",        "keywords": ["network"] },
    "chapter.train":      { "kind": "section",  "stage": "train",      "keywords": ["training", "experiments", "ablation"] },
    "chapter.eval":       { "kind": "section",  "stage": "eval",       "keywords": ["test", "evaluation", "results"] },
    "chapter.pack":       { "kind": "section",  "stage": "pack",       "keywords": ["serving", "bundle", "deploy"] },
    "shape.lineage":      { "kind": "figure",   "stage": "shape",      "keywords": ["shaping", "recipe", "lineage"] },
    "blueprint.modules":  { "kind": "figure",   "stage": "blueprint",  "keywords": ["architecture", "ports", "modules"] },
    "net.blocks":         { "kind": "figure",   "stage": "net",        "keywords": ["network", "blocks"] },
    "net.decisions":      { "kind": "table",    "stage": "net",        "keywords": ["network", "decisions"] },
    "net.forward":        { "kind": "equation", "stage": "net",        "keywords": ["mlp", "network", "forward"] },
    "net.loss":           { "kind": "equation", "stage": "net",        "keywords": ["loss"] },
    "net.update":         { "kind": "equation", "stage": "net",        "keywords": ["update", "optimizer", "schedule"] },
    "train.ladder":       { "kind": "figure",   "stage": "train",      "keywords": ["ladder", "ablation"] },
    "train.curves":       { "kind": "figure",   "stage": "train",      "keywords": ["curves", "dynamics"] },
    "eval.metrics":       { "kind": "table",    "stage": "eval",       "keywords": ["test", "metrics"] },
    "eval.calibration":   { "kind": "figure",   "stage": "eval",       "keywords": ["reliability", "calibration"] },
    "pack.layout":        { "kind": "figure",   "stage": "pack",       "keywords": ["bundle", "layout"] },
    "pack.slice":         { "kind": "figure",   "stage": "pack",       "keywords": ["serving", "slice"] },
    "conclusion":         { "kind": "section",  "stage": "pack",       "keywords": ["conclusion"] }
  },
  "label_kinds": {
    "kinds": ["section", "figure", "table", "equation"],
    "anchor_prefixes": { "chapter.": "section", "section.": "section", "subsection.": "section", "subsubsection.": "section",
                         "figure.": "figure", "table.": "table", "equation.": "equation", "AMS.": "equation" },
    "label_prefixes": { "sec:": "section", "fig:": "figure", "tab:": "table", "eq:": "equation" },
    "label_key": "report.kind.<kind>"
  },
  "briefs": {
    "stages": {
      "shape":     "<records/shape.json#manifest.outputs.dir>/docs/shape-brief.md",
      "blueprint": "<the run directory of records/architecture.json#netspec.input.pipeline>/docs/blueprint-brief.md",
      "net":       "<records/architecture.json#netspec.outputs.run_dir>/docs/net-brief.md",
      "train":     "<records/training.json#campaign.run_dir>/docs/train-brief.md",
      "eval":      "<records/training.json#campaign.run_dir>/docs/eval-brief.md",
      "pack":      "<bundle>/docs/pack-brief.md"
    },
    "copy": "briefs/<stage>-brief.md",
    "link_kind": "file"
  },

  "walk": {
    "head": ["root", "store", "build"],
    "tail": ["forward", "link", "shape", "run", "explain", "route"],
    "blocks": "one id per distinct block type of netspec.blocks, in forward order, named by the type",
    "computed_by": "page_config.build_walk (W06)",
    "anchors": {
      "blocks": "blocks_core.py | blocks_seq.py | blocks_graph.py | blocks_gen.py by SEGMENT_FILE",
      "build": "network.py ^build_model = ",
      "store": "store.py ^\\s+def load\\(",
      "route": "serve/routes_predict.py ^def register\\("
    }
  },
  "walk_roles": {
    "root":    ["blueprint.modules", "chapter.blueprint"],
    "store":   ["pack.slice", "chapter.pack"],
    "build":   ["net.decisions", "net.blocks", "chapter.net"],
    "forward": ["net.forward"],
    "link":    ["net.forward", "net.loss"],
    "shape":   ["shape.lineage", "chapter.shape"],
    "run":     ["pack.slice"],
    "explain": ["net.forward"],
    "route":   ["pack.slice", "chapter.pack"],
    "dense": ["net.forward", "net.blocks"], "embedding": ["net.forward", "net.blocks"], "concat": ["net.forward", "net.blocks"],
    "batchnorm": ["net.forward", "net.blocks"], "layernorm": ["net.forward", "net.blocks"], "dropout": ["net.blocks", "net.decisions"],
    "activation": ["net.forward", "net.blocks"], "residual": ["net.forward", "net.blocks"], "sequential": ["net.forward", "net.blocks"],
    "parallel": ["net.forward", "net.blocks"], "conv1d": ["net.forward", "net.blocks"], "pool1d": ["net.forward", "net.blocks"],
    "rnn": ["net.forward", "net.blocks"], "gru": ["net.forward", "net.blocks"], "lstm": ["net.forward", "net.blocks"],
    "attention": ["net.forward", "net.blocks"], "attention_pool": ["net.forward", "net.blocks"],
    "transformer_encoder": ["net.forward", "net.blocks"], "feature_tokenizer": ["net.forward", "net.blocks"],
    "positional": ["net.forward", "net.blocks"], "flatten": ["net.forward", "net.blocks"], "reshape": ["net.forward", "net.blocks"],
    "pool": ["net.forward", "net.blocks"], "head": ["net.forward", "net.blocks"], "decoder": ["net.forward", "net.blocks"],
    "reparameterize": ["net.forward", "net.blocks"], "gcn_conv": ["net.forward", "net.blocks"], "sage_conv": ["net.forward", "net.blocks"],
    "gat_conv": ["net.forward", "net.blocks"], "gin_conv": ["net.forward", "net.blocks"], "graph_pool": ["net.forward", "net.blocks"],
    "edge_dropout": ["net.blocks", "net.decisions"], "custom": ["net.blocks", "chapter.net"]
  },

  "views": {
    "ids": ["start", "context", "network", "try", "many", "results", "code"],
    "tour": ["context", "network", "try", "many", "results"],
    "sub_views": { "network": ["tried", "weights"] },
    "aliases": { "window": "many" }
  },

  "page": {
    "recipe_ops": ["impute", "indicator", "encode", "clip", "log1p", "standard_scale", "robust_scale", "minmax_scale", "bin",
                   "window", "graph_edges", "project", "other"],
    "reference_kinds": ["reconstruction_error", "distance"],
    "levels": ["node", "graph"],
    "built_by": "page_config.build_page_config (W06), inside build_showcase.py after resolve_story",
    "links_source": "vega-forge/scripts/catalog.json#inspection.links (R-C1)"
  },
  "attribution": {
    "targets": ["logit", "binary_logit", "label_logit", "value", "quantile", "expected_rank", "threshold_logit",
                "reconstruction_error", "feature_error", "svdd_distance", "forecast_step"],
    "methods": ["grad_x_input", "integrated_gradients"],
    "reduce": ["sum_over_steps", "self_only"],
    "axis_kinds": ["class", "label", "bin", "group", "horizon"],
    "source_part": "train",
    "built_by": "attribution_build.py (H06) through predict.load_inspector(bundle).attribute(...) over examples/demo.json's strata"
  },
  "probe": {
    "query": "probe", "result_id": "showcase-probe", "schema": "vega/page-probe@1", "hook": "window.__showcase",
    "hook_members": ["version", "ready", "lane", "story", "page", "graph", "registry", "views", "current", "state", "math",
                     "missingKeys", "fetched", "probe"],
    "qps_dir": ".work/qps/"
  },
  "template": {
    "dir": "assets/page", "manifest": "TEMPLATE.json", "schema": "vega/page-template@1", "name": "vega-show/page",
    "excluded": ["TEMPLATE.json", "package.json", "tests/"],
    "strings_keys": "assets/page/strings.keys.json",
    "required_files": ["assets/page/index.html", "assets/page/TEMPLATE.json", "assets/page/strings.keys.json"]
  },
  "page_keys": {
    "context.step.{id}":  "context_steps.ids",
    "model.{name}":       "result_models.names",
    "report.kind.{kind}": "label_kinds.kinds",
    "metric.{metric}":    "the task primaries (vega-forge tasks[].primary and primary_alt.metric, vega-eval tasks[].primary; R-C7 anomaly_score_mean) ∪ results_facts ∪ breakdown metrics"
  },

  "showcase": {
    "dir": "showcase", "manifest": "SHOWCASE.json", "entry": "page/index.html",
    "files": {
      "page/**":                 { "schema": "vega/page-template@1", "role": "page",   "served": true,  "pinned": true,  "when": "always" },
      "page.json":               { "schema": "vega/page@1",          "role": "page",   "served": true,  "pinned": true,  "when": "always" },
      "story.json":              { "schema": "vega/story@2",         "role": "story",  "served": true,  "pinned": true,  "when": "always" },
      "data/attribution.json":   { "schema": "vega/attribution@2",   "role": "data",   "served": true,  "pinned": true,  "when": "optional" },
      "report/report.pdf":       { "schema": null,                   "role": "report", "served": true,  "pinned": true,  "when": "linked" },
      "briefs/<stage>-brief.md": { "schema": null,                   "role": "report", "served": true,  "pinned": true,  "when": "brief-links" },
      "plan/facts.json":         { "schema": "vega/show-facts@1",    "role": "record", "served": false, "pinned": true,  "when": "always" },
      "plan/story-plan.json":    { "schema": "vega/story-plan@2",    "role": "record", "served": false, "pinned": true,  "when": "always" },
      "docs/show-brief.md":      { "schema": null,                   "role": null,     "served": false, "pinned": false, "when": "after publish" },
      ".work/**":                { "schema": null,                   "role": null,     "served": false, "pinned": false, "when": "scratch" },
      ".smoke/**":               { "schema": null,                   "role": null,     "served": false, "pinned": false, "when": "scratch" }
    },
    "roles": ["page", "story", "report", "data", "record"],
    "served_roles": ["page", "story", "report", "data"],
    "unpinned_dirs": [".work/", ".smoke/", "docs/"],
    "siblings": { "previous": "showcase.prev", "building": "showcase.building" },
    "path_pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]{1,200}$",
    "report_status": ["linked", "brief-links"],
    "role_origins": ["document-project", "proposed"]
  },
  "showcase_extensions": {
    "anywhere": [".html", ".json", ".pdf", ".md"],
    "under": { "page/": [".js", ".css", ".svg", ".woff2"], ".work/qps/page/": [".js", ".css", ".svg", ".woff2"], ".smoke/": [".png"] },
    "refused": [".py", ".pyc", ".so"]
  },

  "slot": {
    "module": "serve/routes_showcase.py", "capability": "showcase", "schema": "vega/showcase@1",
    "dir": "showcase", "manifest": "SHOWCASE.json", "env": "<ENV>_SHOWCASE", "flag": "--showcase",
    "routes": ["GET /", "GET /console", "GET /showcase/{path}", "GET /v1/story", "GET /report.pdf", "GET /v1/showcase"],
    "open_while_unready": ["/", "/console", "/showcase/", "/v1/showcase"],
    "reads": ["schema", "bundle.manifest_digest", "bundle.model_version", "entry", "story.file", "report.pdf.file",
              "report.pdf.digest", "files", "served"],
    "status_fields": ["present", "verified", "reason", "digest", "entry", "template", "report_status", "created_at", "files", "unlisted"],
    "max_bytes": 67108864,
    "media": { ".html": "text/html; charset=utf-8", ".json": "application/json", ".js": "text/javascript; charset=utf-8",
               ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg",
               ".webp": "image/webp", ".woff2": "font/woff2", ".pdf": "application/pdf", ".txt": "text/plain; charset=utf-8",
               ".md": "text/markdown; charset=utf-8" },
    "headers": { "Cache-Control": "no-cache", "X-Content-Type-Options": "nosniff", "ETag": "the file's digest (304 on If-None-Match)" },
    "manifest_record": { "key": "MANIFEST.json#serve.showcase_slot", "written_by": "pack (S07) whenever serve/ is rendered" },
    "stale_reason": "the bundle was re-emitted after this showcase; re-run /vega-show",
    "dockerignore": { "keep": ["showcase/"], "exclude": ["showcase.prev/", "showcase.building/", "showcase/.smoke/", "showcase/.work/"] }
  },

  "layer": { "name": "showcase", "tab": "Showcase", "schema": "vega/showcase-layer@1", "max_render_kb": 40, "max_data_kb": 400,
             "required": ["schema", "showcase", "story", "bindings", "report", "checks", "usage", "readings.abstract"],
             "surfaces": ["story", "bindings", "report", "open it", "checks", "markers and readings"] },

  "stances": {
    "section": "Network stances",
    "prefix": "show:",
    "lines": {
      "roles":    "YYYY-MM-DD | <dataset> | show: roles <class> <role> (<basis>), … (user)",
      "motif":    "YYYY-MM-DD | <dataset> | show: motif <id> (user)",
      "lexicon":  "YYYY-MM-DD | <dataset> | show: lexicon <key> <one>/<many> (user)",
      "showcase": "YYYY-MM-DD | <dataset> | show: showcase of <slug>-<run>, report <linked|brief-links>, motif <id>, roles <summary>"
    }
  },

  "forks": {
    "S1": { "name": "report", "when": "no compiled report was found (document did not run); a report without a label-role map takes proposed roles instead",
            "attended": "FORK: continue with brief links, or stop and run /document-project vega <lane> first",
            "unattended": "brief links",
            "marker": "WARN: no report — code notes link to the stage briefs; re-run /vega-show after /document-project",
            "cases": ["VS16", "VS17"] },
    "S2": { "name": "roles", "when": "the draft proposes an alert role, or domain:/spec: evidence raised one, and no user: turn or show: stance settles it",
            "attended": "FORK: per-class roles, the proposal first (neutral <class> by its rule, alert candidates, plain for the rest)",
            "unattended": "an unsupported alert becomes plain; a structural neutral is kept; the anomalous side under task:anomaly is never downgraded",
            "marker": "WARN: alert downgraded to plain without a user: turn or a show: stance — <classes>",
            "cases": [] },
    "S3": { "name": "motif", "when": "the modality admits more than one motif and no show: motif stance exists",
            "attended": "FORK: motif — the modality's base first, the admissible variants with a one-line reason",
            "unattended": "the base",
            "marker": "OK: motif <base> (the modality's base, unattended)",
            "cases": [] }
  },

  "gates": [
    { "id": "V1",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "the plan's facts digest equals sha256(plan/facts.json) and its template digest equals sha256(assets/page/TEMPLATE.json)", "cases": ["D5-21"] },
    { "id": "V2",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "the digit rule over every authored string", "cases": ["D5-1", "D5-2", "D5-3", "VS01"] },
    { "id": "V3",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "every placeholder is a fact key or a lexicon path, with a known format suffix", "cases": ["D5-4", "VS02"] },
    { "id": "V4",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "no record path, #-ref, sha256: or report: in authored text", "cases": ["D5-5", "VS03"] },
    { "id": "V5",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "closed sets: locale, motif admissible for the modality, lexicon keys and values", "cases": ["D5-6", "VS07", "VS08", "VS09", "VS10", "PN6"] },
    { "id": "V6",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "class roles: every class once, neutral bound, alert only on user:, show: or task:anomaly, no role without classes", "cases": ["D5-7", "D5-8", "D5-9", "VS04", "VS05", "VS06", "PN5"] },
    { "id": "V7",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "input groups partition the shaped inputs, within the count bounds, with unique ids", "cases": ["D5-10", "D5-11", "D5-12", "VS11", "VS12", "VS13", "PN12"] },
    { "id": "V8",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "choices: known decisions, every mandatory one present, within the count bounds, focus kinds valid", "cases": ["D5-13", "D5-14"] },
    { "id": "V9",  "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "limits: every mandatory limit covered, every id known", "cases": ["D5-15"] },
    { "id": "V10", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "experiment labels are keyed by exactly the proposed runs", "cases": ["D5-16"] },
    { "id": "V11", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "code notes are keyed by proposed walk ids only", "cases": ["D5-17"] },
    { "id": "V12", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "lengths per authored_lengths", "cases": ["D5-18", "VS23"] },
    { "id": "V13", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "status is authored and every required slot is non-null", "cases": ["D5-19"] },
    { "id": "V14", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "an authored report role is a catalog role whose label exists in the .aux with the role's kind", "cases": ["D5-20", "VS14"] },
    { "id": "V15", "group": "validate",  "where": "plan_rules.py", "exit": 2, "rule": "claims the facts contradict: a softened beaten verdict, a breakdown of another metric called the primary, choices sharing a title or a non-block called a block, input groups sharing a label (plan_claims.py)", "cases": ["GC-1", "GC-2", "GC-3", "GC-4"] },

    { "id": "PF1", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "the model page reads (its layers through domain-forge's apply_layer.py), is the /vega-pack page with every required layer, and its bundle layer's manifest equals MANIFEST.json (canonical JSON; a non-finite number in it is named and refused)", "cases": ["D5-23", "VS18"] },
    { "id": "PF2", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "MANIFEST.json and every pinned record read and match their MANIFEST.files digests (BundleAltered); the bundle pins the spec and a record of every required layer; the evaluation records a network estimate of the primary; MANIFEST.json holds no NaN or infinity; the fact set validates show-facts-1.schema.json", "cases": ["D5-22"] },
    { "id": "PF3", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "predict.py --check passes from a clean shell", "cases": [] },
    { "id": "PF4", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "the bundle has a service and MANIFEST.serve.showcase_slot (else ERROR naming --serve)", "cases": ["D5-24", "VS24"] },
    { "id": "PF5", "group": "preflight", "where": "build_showcase.py", "exit": 2, "rule": "TEMPLATE.json requires_endpoints ⊆ MANIFEST.serve.endpoints", "cases": [] },
    { "id": "PF6", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "the report's labels read and are current: the label-role map exists and is not older than its .aux (else ERROR: recompile /document-project), --report names a compiled report, the .aux parses", "cases": ["D5-29", "VS15"] },
    { "id": "PF7", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "the task kind, family, every block type (inner blocks included) and the sample shape are in the vega-forge catalog, the primary has a max/min direction there, a sequence-* task has a base kind sequence_map knows, the vega-show catalog has a view key for the task, and the spec names a network input (ERROR, never skipped)", "cases": ["D5-36", "D5-37"] },
    { "id": "PF8", "group": "preflight", "where": "extract_facts.py", "exit": 2, "rule": "MANIFEST.roundtrip.status is not fail", "cases": ["VS25"] },
    { "id": "PF9", "group": "preflight", "where": "build_showcase.py", "exit": 2, "rule": "MANIFEST.files pins no showcase/ path (two owners)", "cases": ["VS27"] },

    { "id": "BD1", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "showcase/page/ is a byte copy of the TEMPLATE.json files (verify_template_copy is empty)", "cases": ["PN4"] },
    { "id": "BD2", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "page.json passes check_page_config (link, motif admissible for the modality, lane against netspec)", "cases": ["PN7"] },
    { "id": "BD3", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "no refused extension anywhere, no page extension outside page/, no .png outside .smoke/", "cases": ["D5-25"] },
    { "id": "BD4", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "every files path is relative, normalised, without .., not a symlink, and SHOWCASE.json is not in files", "cases": [] },
    { "id": "BD5", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "served ⊆ files; the entry is a served .html under page/", "cases": ["D5-26"] },
    { "id": "BD6", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "SHOWCASE.json validates vega/showcase@1", "cases": [] },
    { "id": "BD7", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "a qps-ploc build writes only under showcase/.work/qps/", "cases": [] },
    { "id": "BD8", "group": "build", "where": "build_showcase.py", "exit": 2, "rule": "the build writes nothing outside showcase*/ and leaves MANIFEST.json's bytes unchanged", "cases": [] },

    { "id": "CK1",  "group": "check", "where": "showcase_check.py", "exit": 2, "rule": "SHOWCASE.json reads and is vega/showcase@1 (broken)", "cases": [] },
    { "id": "CK2",  "group": "check", "where": "showcase_check.py", "exit": 2, "rule": "every files digest matches (broken)", "cases": ["D5-32", "PN4"] },
    { "id": "CK3",  "group": "check", "where": "showcase_check.py", "exit": 2, "rule": "no refused extension, no path-invariant breach, no unlisted media file outside the unpinned directories (broken)", "cases": ["D5-25"] },
    { "id": "CK4",  "group": "check", "where": "showcase_check.py", "exit": 2, "rule": "served ⊆ files (broken)", "cases": ["D5-26"] },
    { "id": "CK5",  "group": "check", "where": "showcase_check.py", "exit": 2, "rule": "bundle.manifest_digest equals sha256(MANIFEST.json), unless CK6 applies (broken)", "cases": ["D5-27"] },
    { "id": "CK6",  "group": "check", "where": "showcase_check.py", "exit": 3, "rule": "bundle.manifest_digest is a previous_manifest_digest of MANIFEST.reemits: the bundle was re-emitted (stale)", "cases": [] },
    { "id": "CK7",  "group": "check", "where": "showcase_check.py", "exit": 3, "rule": "the report pdf, aux and role-map source digests are unchanged (stale)", "cases": ["D5-28"] },
    { "id": "CK8",  "group": "check", "where": "showcase_check.py", "exit": 3, "rule": "in brief-link mode, every brief source digest is unchanged (stale)", "cases": [] },
    { "id": "CK9",  "group": "check", "where": "showcase_check.py", "exit": 3, "rule": "no report exists now where the showcase records brief-links (stale)", "cases": [] },
    { "id": "CK10", "group": "check", "where": "showcase_check.py", "exit": 0, "rule": "the installed template digest equals the one recorded (WARN: template updated since build, not stale)", "cases": [] },

    { "id": "SL1",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "schema is vega/showcase@1", "cases": ["SS9"] },
    { "id": "SL2",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "bundle.manifest_digest and bundle.model_version match the running bundle", "cases": ["SS2", "D5-27"] },
    { "id": "SL3",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "a showcase of a re-emitted bundle is refused with the stale reason", "cases": [] },
    { "id": "SL4",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "no absolute path, no .. segment, nothing outside the directory", "cases": ["SS3"] },
    { "id": "SL5",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "no symlink", "cases": ["SS6"] },
    { "id": "SL6",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "every files digest matches the bytes read at start", "cases": ["SS1", "D5-32"] },
    { "id": "SL7",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "the total stays within max_bytes", "cases": [] },
    { "id": "SL8",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "no unlisted file with a media extension outside .work/, .smoke/ and docs/", "cases": ["SS4"] },
    { "id": "SL9",  "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "served ⊆ files; entry, story.file and report.pdf.file are served", "cases": ["D5-26"] },
    { "id": "SL10", "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "the bundle's MANIFEST.files pins no showcase/ path (two owners)", "cases": ["SS7"] },
    { "id": "SL11", "group": "slot", "where": "serve/routes_showcase.py", "exit": null, "rule": "a showcase file never shadows a service route (health, v1/*)", "cases": ["SS5"] },

    { "id": "LY1", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "checks.status is pass", "cases": ["D5-34"] },
    { "id": "LY2", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "the served smoke passed, or the markers carry WARN: served page not checked", "cases": ["VS21"] },
    { "id": "LY3", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "readings.abstract is present, at least abstract_min characters, and passes the digit rule", "cases": ["D5-33"] },
    { "id": "LY4", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "brief-links carries the WARN: no report marker", "cases": ["D5-35"] },
    { "id": "LY5", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "SHOWCASE.json pins the current bundle MANIFEST.json digest", "cases": [] },
    { "id": "LY6", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "the data is within max_data_kb and the render within max_render_kb", "cases": [] },
    { "id": "LY7", "group": "layer", "where": "apply_show_layer.py", "exit": 2, "rule": "--out differs from the input", "cases": ["VS22"] },

    { "id": "PG1",  "group": "page", "where": "tests/test_page_template.py", "exit": 1, "rule": "TEMPLATE.json equals page_template.write_manifest()", "cases": [] },
    { "id": "PG2",  "group": "page", "where": "page_lint.literals", "exit": 1, "rule": "no prose literal outside the strings table", "cases": ["PN1"] },
    { "id": "PG3",  "group": "page", "where": "lint_templates.py", "exit": 2, "rule": "no foreign literal or harvested lane token in a template file", "cases": ["PN1", "D5-31", "VS20"] },
    { "id": "PG4",  "group": "page", "where": "tests/test_page_template.py", "exit": 1, "rule": "no role literal (calm, threat, benign, attack) in a module or page.css", "cases": ["PN3"] },
    { "id": "PG5",  "group": "page", "where": "tests/test_page_template.py", "exit": 1, "rule": "strings values and explain-catalog prose pass the digit rule", "cases": ["PN2"] },
    { "id": "PG6",  "group": "page", "where": "tests/test_page_template.py", "exit": 1, "rule": "every used key exists, every dynamic prefix is declared, no dead key", "cases": ["VS19"] },
    { "id": "PG7",  "group": "page", "where": "tests/test_page_template.py", "exit": 1, "rule": "no {{…}} token in any template file", "cases": ["D5-30"] },
    { "id": "PG8",  "group": "page", "where": "style_lock.py", "exit": 1, "rule": "the locked style tokens and computed styles are unchanged", "cases": ["PN10"] },
    { "id": "PG9",  "group": "page", "where": "tests/test_page_size.py", "exit": 1, "rule": "PS1–PS5 (module, function, class length, parameters, module state)", "cases": ["PN11"] },
