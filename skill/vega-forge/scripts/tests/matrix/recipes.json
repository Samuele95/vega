{
  "schema": "vega/backend-matrix-recipes@1",
  "source": "D1 §2 (the cells), §6 (the family recipes), §17.2 (the matrix); BUILD-PLAN B19, R-B5, R-H5; vega-forge/scripts/catalog.json admission (the closed cell list this table must equal)",
  "note": "One row per admission group: its families, shape, level and tasks, the matrix variant its cells run under and the raw fixture they read. `variants` are the admission table's extra cells, each a change of the sample on one (family, task). `families` is each family's composition at the matrix's small sizes, the catalog's composition text made concrete: a string item is a placeholder the composer expands — `embed` (an embedding of every nominal, then concat), `flatten@window` (flatten on a window sample only), `pool@graph` (graph_pool at level graph only, with the family's `pool` readout), `head` (the task's head: out and activation forced by the task row). `smoke` is one cell per family (21); `sanity` the learning checks (D1 §17.2), each a fit at `epochs` against a floor cell or a baseline, on valid, in the primary's direction.",
  "seed": 7,
  "epochs": 3,
  "split": {"test": 0.2, "valid": 0.2},
  "optimizer": {"name": "adamw", "params": {"lr": 0.003, "weight_decay": 0.0001}},
  "lr_by_shape": {"graph-node": 0.02, "graph-graph": 0.02},
  "batch_size": {"row": 64, "window": 64, "graph-node": "full", "graph-graph": 16},
  "window": {"length": 12, "horizon": 3, "season": 12},
  "edges": {"default": "key_pair", "by_family": {"gat": "knn"}},
  "groups": [
    {"id": "RS", "families": ["mlp-plain", "mlp-residual", "ft-transformer", "linear"], "shape": "row", "level": null,
     "tasks": ["binary", "multiclass", "multilabel", "regression", "ordinal"], "variant": "nominals", "data": "rows"},
    {"id": "RR", "families": ["autoencoder", "vae", "pca-floor"], "shape": "row", "level": null,
     "tasks": ["unsupervised", "anomaly/labelled", "anomaly/unlabelled"], "variant": "nominals", "data": "rows"},
    {"id": "SV", "families": ["deep-svdd"], "shape": "row", "level": null,
     "tasks": ["anomaly/labelled", "anomaly/unlabelled"], "variant": "nominals", "data": "rows"},
    {"id": "WF", "families": ["cnn1d", "gru", "lstm", "transformer-seq", "rnn", "lstm-attention", "gru-attention"], "shape": "window", "level": null,
     "tasks": ["sequence-classification/binary", "sequence-classification/multiclass", "sequence-classification/multilabel", "sequence-regression/regression", "sequence-regression/ordinal", "forecast"], "variant": "stride-1", "data": "seq"},
    {"id": "BI", "families": ["bi-lstm", "bi-gru"], "shape": "window", "level": null,
     "tasks": ["sequence-classification/binary", "sequence-classification/multiclass", "sequence-classification/multilabel", "sequence-regression/regression", "sequence-regression/ordinal"], "variant": "stride-1", "data": "seq"},
    {"id": "LW", "families": ["linear"], "shape": "window", "level": null,
     "tasks": ["sequence-classification/binary", "sequence-classification/multiclass", "sequence-classification/multilabel", "sequence-regression/regression", "sequence-regression/ordinal", "forecast"], "variant": "stride-1", "data": "seq"},
    {"id": "GN", "families": ["gcn", "graphsage", "gat"], "shape": "graph", "level": "node",
     "tasks": ["binary", "multiclass", "multilabel", "regression", "ordinal"], "variant": "inductive-full", "data": "nodes"},
    {"id": "GG", "families": ["gcn", "graphsage", "gat", "gin"], "shape": "graph", "level": "graph",
     "tasks": ["binary", "multiclass", "regression"], "variant": "graphs", "data": "graphs"},
    {"id": "LG", "families": ["linear"], "shape": "graph", "level": "node",
     "tasks": ["binary", "multiclass", "multilabel", "regression", "ordinal"], "variant": "inductive-full", "data": "nodes"},
    {"id": "LG", "families": ["linear"], "shape": "graph", "level": "graph",
     "tasks": ["binary", "multiclass", "regression"], "variant": "graphs", "data": "graphs"}
  ],
  "variants": [
    {"family": "gru", "shape": "window", "level": null, "task": "sequence-classification/binary", "admission": "stride 2", "variant": "stride-2",
     "sample": {"stride": 2}, "why": "training anchors thinned by the stride; scoring stays dense (R-A5)"},
    {"family": "gcn", "shape": "graph", "level": "node", "task": "multiclass", "admission": "transductive", "variant": "transductive-full",
     "sample": {"protocol": "transductive"}, "why": "the test nodes' features in the training graph, their labels sealed (D1 §9.4)"},
    {"family": "graphsage", "shape": "graph", "level": "node", "task": "multiclass", "admission": "sampled", "variant": "inductive-sampled",
     "sample": {"batching": "sampled", "neighbours": [6, 6]}, "batch_size": 64, "why": "neighbour sampling, one fan-out per conv block"}
  ],
  "families": {
    "mlp-plain": ["embed",
      {"type": "dense", "params": {"units": 32, "activation": "none"}}, {"type": "activation", "params": {"name": "relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      {"type": "dense", "params": {"units": 32, "activation": "none"}}, {"type": "activation", "params": {"name": "relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      "head"],
    "mlp-residual": ["embed",
      {"type": "dense", "params": {"units": 32, "activation": "none"}},
      {"type": "residual", "params": {"repeat": 2, "projection": "auto", "inner": [
        {"type": "dense", "params": {"units": 32, "activation": "none"}}, {"type": "batchnorm", "params": {}},
        {"type": "activation", "params": {"name": "gelu"}}, {"type": "dropout", "params": {"p": 0.2}}]}},
      "head"],
    "ft-transformer": [
      {"type": "feature_tokenizer", "params": {"d": 16}},
      {"type": "transformer_encoder", "params": {"d": 16, "heads": 2, "layers": 1, "ff": 32, "dropout": 0.1}},
      {"type": "pool", "params": {"kind": "cls"}},
      "head"],
    "linear": ["embed", "flatten@window", "pool@graph", "head"],
    "autoencoder": ["embed",
      {"type": "sequential", "params": {"inner": [{"type": "dense", "params": {"units": 16, "activation": "none"}}, {"type": "activation", "params": {"name": "relu"}}]}},
      {"type": "dense", "params": {"units": 4, "activation": "none"}},
      {"type": "decoder", "params": {"widths": [16], "activation": "relu"}},
      "head"],
    "vae": ["embed",
      {"type": "sequential", "params": {"inner": [{"type": "dense", "params": {"units": 16, "activation": "gelu"}}]}},
      {"type": "dense", "params": {"units": 8, "activation": "none"}},
      {"type": "reparameterize", "params": {"z": 4}},
      {"type": "decoder", "params": {"widths": [16], "activation": "gelu"}},
      "head"],
    "pca-floor": ["embed", {"type": "dense", "params": {"units": 3, "activation": "none"}}, "head"],
    "deep-svdd": ["embed",
      {"type": "sequential", "params": {"inner": [{"type": "dense", "params": {"units": 16, "activation": "none"}}, {"type": "activation", "params": {"name": "tanh"}}]}},
      {"$": "head", "z": 8, "bias": false}],
    "cnn1d": ["embed",
      {"type": "conv1d", "params": {"channels": 16, "kernel": 3, "padding": 1}}, {"type": "activation", "params": {"name": "gelu"}},
      {"type": "pool1d", "params": {"kind": "max", "size": 2}}, {"type": "flatten", "params": {}},
      {"type": "dense", "params": {"units": 32, "activation": "relu"}},
      "head"],
    "gru": ["embed", {"type": "gru", "params": {"hidden": 32, "num_layers": 1, "return": "all"}}, {"type": "pool", "params": {"kind": "mean"}}, "head"],
    "lstm": ["embed", {"type": "lstm", "params": {"hidden": 32, "num_layers": 1, "return": "all"}}, {"type": "pool", "params": {"kind": "mean"}}, "head"],
    "transformer-seq": ["embed",
      {"type": "dense", "params": {"units": 16, "activation": "none"}}, {"type": "positional", "params": {"kind": "sinusoidal"}},
      {"type": "transformer_encoder", "params": {"d": 16, "heads": 2, "layers": 1, "ff": 32, "dropout": 0.1}},
      {"type": "pool", "params": {"kind": "mean"}},
      "head"],
    "rnn": ["embed", {"type": "rnn", "params": {"hidden": 16, "num_layers": 1, "nonlinearity": "tanh", "return": "last"}}, {"type": "dropout", "params": {"p": 0.1}}, "head"],
    "bi-lstm": ["embed", {"type": "lstm", "params": {"hidden": 16, "num_layers": 1, "bidirectional": true, "return": "last"}}, {"type": "dropout", "params": {"p": 0.1}}, "head"],
    "bi-gru": ["embed", {"type": "gru", "params": {"hidden": 16, "num_layers": 1, "bidirectional": true, "return": "last"}}, {"type": "dropout", "params": {"p": 0.1}}, "head"],
    "lstm-attention": ["embed", {"type": "lstm", "params": {"hidden": 16, "num_layers": 1, "return": "all"}}, {"type": "attention_pool", "params": {"hidden": 16}}, {"type": "dropout", "params": {"p": 0.1}}, "head"],
    "gru-attention": ["embed", {"type": "gru", "params": {"hidden": 16, "num_layers": 1, "return": "all"}}, {"type": "attention_pool", "params": {"hidden": 16}}, {"type": "dropout", "params": {"p": 0.1}}, "head"],
    "gcn": ["embed",
      {"type": "gcn_conv", "params": {"out": 32}}, {"type": "activation", "params": {"name": "relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      {"type": "gcn_conv", "params": {"out": 32}}, {"type": "activation", "params": {"name": "relu"}},
      "pool@graph", "head"],
    "graphsage": ["embed",
      {"type": "sage_conv", "params": {"out": 32, "aggregator": "mean"}}, {"type": "activation", "params": {"name": "relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      {"type": "sage_conv", "params": {"out": 32, "aggregator": "mean"}}, {"type": "activation", "params": {"name": "relu"}},
      "pool@graph", "head"],
    "gat": [{"type": "edge_dropout", "params": {"p": 0.1}}, "embed",
      {"type": "gat_conv", "params": {"out": 8, "heads": 4, "concat": true}}, {"type": "activation", "params": {"name": "leaky_relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      {"type": "gat_conv", "params": {"out": 16, "heads": 1, "concat": false}}, {"type": "activation", "params": {"name": "leaky_relu"}},
      "pool@graph", "head"],
    "gin": ["embed",
      {"type": "gin_conv", "params": {"out": 32}}, {"type": "activation", "params": {"name": "relu"}}, {"type": "dropout", "params": {"p": 0.1}},
      {"type": "gin_conv", "params": {"out": 32}}, {"type": "activation", "params": {"name": "relu"}},
      "pool@graph", "head"]
  },
  "pool": {"default": "mean", "by_family": {"gin": "sum"}},
  "smoke": [
    "mlp-plain/row/binary/nominals",
    "mlp-residual/row/multiclass/nominals",
    "ft-transformer/row/multilabel/nominals",
    "linear/row/ordinal/nominals",
    "autoencoder/row/anomaly:labelled/nominals",
    "vae/row/unsupervised/nominals",
    "pca-floor/row/anomaly:unlabelled/nominals",
    "deep-svdd/row/anomaly:labelled/nominals",
    "cnn1d/window/sequence-classification:multiclass/stride-1",
    "gru/window/forecast/stride-1",
    "lstm/window/sequence-regression:regression/stride-1",
    "transformer-seq/window/sequence-classification:binary/stride-1",
    "rnn/window/sequence-regression:ordinal/stride-1",
    "lstm-attention/window/sequence-classification:multilabel/stride-1",
    "gru-attention/window/forecast/stride-1",
    "bi-lstm/window/sequence-classification:binary/stride-1",
    "bi-gru/window/sequence-regression:regression/stride-1",
    "gcn/graph-node/multiclass/inductive-full",
    "graphsage/graph-node/binary/inductive-full",
    "gat/graph-node/regression/inductive-full",
    "gin/graph-graph/binary/graphs"
  ],
  "sanity": [
    {"id": "gcn-over-linear", "cell": "gcn/graph-node/multiclass/inductive-full",
     "floor": {"cell": "linear/graph-node/multiclass/inductive-full"}, "epochs": 30,
     "why": "the node's own features say its community weakly; its clique mates say it (D1 Appendix A: 0.93 vs 0.68)"},
    {"id": "gin-over-linear-pool", "cell": "gin/graph-graph/binary/graphs",
     "floor": {"cell": "linear/graph-graph/binary/graphs"}, "epochs": 30,
     "why": "a ring and a chain have the same node features; only the structure tells them apart"},
    {"id": "gru-over-naive", "cell": "gru/window/forecast/stride-1",
     "floor": {"baseline": "naive"}, "epochs": 30,
     "why": "a seasonal series: the last value repeated misses the season a window of it shows"}
  ]
}
